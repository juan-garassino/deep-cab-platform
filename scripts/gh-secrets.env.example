# Shared GitHub Actions SECRETS — uploaded to ALL three deepCab repos.
# Copy to gh-secrets.env (gitignored) and fill in real values.
#
# `make sync_gh` (or `deepcab-platform sync-gh`) picks up this file and pushes
# each KEY=VALUE pair as a repo-level secret via `gh secret set -f`. Empty
# values are skipped (the workflows guard with `if: <var> != ''` so missing
# notifications no-op cleanly).

# Slack incoming webhook. Get from a Slack workspace settings → Apps →
# Incoming Webhooks. Discord webhooks ending in /slack also work as a
# drop-in (point at https://discord.com/api/webhooks/<id>/<token>/slack).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/PLEASE

# Telegram bot token from @BotFather (looks like 1234567890:ABCDEF...).
# `/newbot` in @BotFather creates a fresh bot in ~30 seconds.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID. After creating the bot, message it once, then:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | python3 -c \
#     "import sys,json; print([u['message']['chat']['id'] for u in json.load(sys.stdin).get('result',[])])"
# Prints your chat ID (a number, usually 9-10 digits).
TELEGRAM_CHAT_ID=
